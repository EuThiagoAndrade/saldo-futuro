# Nomes das variáveis de ambiente. Nunca coloque valores neste arquivo.
# Copie para .env.local e preencha localmente; o Git ignora .env.local.

# Supabase (opcionais: sem elas, a aplicação roda sem backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Login por senha: só no ambiente local e no CI. Nunca em produção.
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=
