# Normaliza finais de linha para LF em todos os arquivos de texto
* text=auto eol=lf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary

# Licença de terceiros versionada sem modificação
design-system/assets/fonts/OFL.txt -whitespace
